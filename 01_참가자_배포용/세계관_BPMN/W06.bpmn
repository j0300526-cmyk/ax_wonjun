      <bpmndi:BPMNEdge id="W06_Flow5_di" bpmnElement="W06_Flow5">
        <di:waypoint x="953.0" y="550.0"/>
        <di:waypoint x="1622.0" y="550.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W06_Flow6_di" bpmnElement="W06_Flow6">
        <di:waypoint x="1175.0" y="166.0"/>
