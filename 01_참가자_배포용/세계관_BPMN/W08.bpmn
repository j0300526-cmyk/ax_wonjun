      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_start_di" bpmnElement="W08_start">
        <dc:Bounds x="206.0" y="150.0" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t1_di" bpmnElement="W08_t1">
        <dc:Bounds x="331.0" y="136.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t2_di" bpmnElement="W08_t2">
        <dc:Bounds x="508.0" y="264.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t3_di" bpmnElement="W08_t3">
        <dc:Bounds x="685.0" y="392.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_gate_di" bpmnElement="W08_gate" isMarkerVisible="true">
        <dc:Bounds x="907.0" y="527.0" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t4_di" bpmnElement="W08_t4">
        <dc:Bounds x="1039.0" y="136.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t5_di" bpmnElement="W08_t5">
        <dc:Bounds x="1216.0" y="264.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_t6_di" bpmnElement="W08_t6">
        <dc:Bounds x="1393.0" y="136.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_end_yes_di" bpmnElement="W08_end_yes">
        <dc:Bounds x="1622.0" y="150.0" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_end_no_di" bpmnElement="W08_end_no">
        <dc:Bounds x="1622.0" y="534.0" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="W08_Flow0_di" bpmnElement="W08_Flow0">
        <di:waypoint x="238.0" y="166.0"/>
        <di:waypoint x="331.0" y="166.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W08_Flow1_di" bpmnElement="W08_Flow1">
