<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="W08_Definitions" targetNamespace="https://ax-challenge.local/bpmn">
  <bpmn:collaboration id="W08_Collaboration">
    <bpmn:participant id="W08_Pool" name="인수 검토와 공급 통합 준비" processRef="W08_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="W08_Process" name="인수 검토와 공급 통합 준비" isExecutable="false">
    <bpmn:documentation>현재 업무를 설명하는 교육용 BPMN. 추가 부서·검토 절차는 안내서의 업무 가정이며 실행 가능한 시스템 설계가 아닙니다. 승인 분기는 사람이 수행한 별도 승인 절차의 결과이며, 세부 승인 단계는 생략했습니다. 보류·재검토 종료는 이번 검토 회차의 종료로, 후속 확인 의무의 종료를 뜻하지 않습니다.</bpmn:documentation>
    <bpmn:laneSet id="W08_Lanes">
      <bpmn:lane id="W08_Lane0" name="전략기획">
        <bpmn:flowNodeRef>W08_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_end_yes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W08_Lane1" name="재무·실사">
        <bpmn:flowNodeRef>W08_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W08_Lane2" name="구매·생산">
        <bpmn:flowNodeRef>W08_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W08_Lane3" name="CEO·이사회">
        <bpmn:flowNodeRef>W08_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W08_end_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="W08_start" name="업무 발생">
      <bpmn:outgoing>W08_Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="W08_t1" name="투자 검토 요청 접수">
      <bpmn:incoming>W08_Flow0</bpmn:incoming>
      <bpmn:outgoing>W08_Flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W08_t2" name="재무·계약자료 취합">
      <bpmn:incoming>W08_Flow1</bpmn:incoming>
      <bpmn:outgoing>W08_Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W08_t3" name="공급 적용성 부서의견 취합">
      <bpmn:incoming>W08_Flow2</bpmn:incoming>
      <bpmn:outgoing>W08_Flow3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="W08_gate" name="추진안이 승인됐는가?">
      <bpmn:incoming>W08_Flow3</bpmn:incoming>
      <bpmn:outgoing>W08_Flow4</bpmn:outgoing>
      <bpmn:outgoing>W08_Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="W08_t4" name="승인조건 후속 안건화">
      <bpmn:incoming>W08_Flow4</bpmn:incoming>
      <bpmn:outgoing>W08_Flow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W08_t5" name="실사·공급검토 회신 확인">
      <bpmn:incoming>W08_Flow6</bpmn:incoming>
      <bpmn:outgoing>W08_Flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W08_t6" name="미해결 조건 회의자료 갱신">
      <bpmn:incoming>W08_Flow7</bpmn:incoming>
      <bpmn:outgoing>W08_Flow8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="W08_end_yes" name="후속 검토 기록">
      <bpmn:incoming>W08_Flow8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W08_end_no" name="추가실사·보류">
      <bpmn:incoming>W08_Flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="W08_Flow0" sourceRef="W08_start" targetRef="W08_t1" name=""/>
    <bpmn:sequenceFlow id="W08_Flow1" sourceRef="W08_t1" targetRef="W08_t2" name=""/>
    <bpmn:sequenceFlow id="W08_Flow2" sourceRef="W08_t2" targetRef="W08_t3" name=""/>
    <bpmn:sequenceFlow id="W08_Flow3" sourceRef="W08_t3" targetRef="W08_gate" name=""/>
    <bpmn:sequenceFlow id="W08_Flow4" sourceRef="W08_gate" targetRef="W08_t4" name="예"/>
    <bpmn:sequenceFlow id="W08_Flow5" sourceRef="W08_gate" targetRef="W08_end_no" name="아니오"/>
    <bpmn:sequenceFlow id="W08_Flow6" sourceRef="W08_t4" targetRef="W08_t5" name=""/>
    <bpmn:sequenceFlow id="W08_Flow7" sourceRef="W08_t5" targetRef="W08_t6" name=""/>
    <bpmn:sequenceFlow id="W08_Flow8" sourceRef="W08_t6" targetRef="W08_end_yes" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="W08_Diagram">
    <bpmndi:BPMNPlane id="W08_Plane" bpmnElement="W08_Collaboration">
      <bpmndi:BPMNShape id="W08_Pool_di" bpmnElement="W08_Pool" isHorizontal="true">
        <dc:Bounds x="24" y="102" width="1752" height="512"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_Lane0_di" bpmnElement="W08_Lane0" isHorizontal="true">
        <dc:Bounds x="54" y="102" width="1722" height="128"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_Lane1_di" bpmnElement="W08_Lane1" isHorizontal="true">
        <dc:Bounds x="54" y="230" width="1722" height="128"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W08_Lane2_di" bpmnElement="W08_Lane2" isHorizontal="true">
