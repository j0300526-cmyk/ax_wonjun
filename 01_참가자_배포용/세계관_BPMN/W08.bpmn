        <di:waypoint x="1622.0" y="550.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W08_Flow6_di" bpmnElement="W08_Flow6">
        <di:waypoint x="1175.0" y="166.0"/>
