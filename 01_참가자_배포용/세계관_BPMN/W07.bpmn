      <bpmndi:BPMNShape id="W07_gate_di" bpmnElement="W07_gate" isMarkerVisible="true">
        <dc:Bounds x="907.0" y="399.0" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_t4_di" bpmnElement="W07_t4">
        <dc:Bounds x="1039.0" y="264.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_t5_di" bpmnElement="W07_t5">
        <dc:Bounds x="1216.0" y="264.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_t6_di" bpmnElement="W07_t6">
        <dc:Bounds x="1393.0" y="136.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_end_yes_di" bpmnElement="W07_end_yes">
        <dc:Bounds x="1622.0" y="150.0" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_end_no_di" bpmnElement="W07_end_no">
        <dc:Bounds x="1622.0" y="406.0" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="W07_Flow0_di" bpmnElement="W07_Flow0">
        <di:waypoint x="238.0" y="166.0"/>
        <di:waypoint x="331.0" y="166.0"/>
      </bpmndi:BPMNEdge>
