<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="W07_Definitions" targetNamespace="https://ax-challenge.local/bpmn">
  <bpmn:collaboration id="W07_Collaboration">
    <bpmn:participant id="W07_Pool" name="관련 거래처와 판매장려금 지급" processRef="W07_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="W07_Process" name="관련 거래처와 판매장려금 지급" isExecutable="false">
    <bpmn:documentation>현재 업무를 설명하는 교육용 BPMN. 추가 부서·검토 절차는 안내서의 업무 가정이며 실행 가능한 시스템 설계가 아닙니다. 승인 분기는 사람이 수행한 별도 승인 절차의 결과이며, 세부 승인 단계는 생략했습니다. 보류·재검토 종료는 이번 검토 회차의 종료로, 후속 확인 의무의 종료를 뜻하지 않습니다.</bpmn:documentation>
    <bpmn:laneSet id="W07_Lanes">
      <bpmn:lane id="W07_Lane0" name="영업지원">
        <bpmn:flowNodeRef>W07_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_end_yes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07_Lane1" name="회계·자금">
        <bpmn:flowNodeRef>W07_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07_Lane2" name="영업지원·영업임원">
        <bpmn:flowNodeRef>W07_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07_end_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="W07_start" name="업무 발생">
      <bpmn:outgoing>W07_Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="W07_t1" name="정산 요청 접수">
      <bpmn:incoming>W07_Flow0</bpmn:incoming>
      <bpmn:outgoing>W07_Flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W07_t2" name="거래처·지급표 취합">
      <bpmn:incoming>W07_Flow1</bpmn:incoming>
      <bpmn:outgoing>W07_Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W07_t3" name="등록정보·한도 검토">
      <bpmn:incoming>W07_Flow2</bpmn:incoming>
      <bpmn:outgoing>W07_Flow3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="W07_gate" name="전결·임원 승인을 받았는가?">
      <bpmn:incoming>W07_Flow3</bpmn:incoming>
      <bpmn:outgoing>W07_Flow4</bpmn:outgoing>
      <bpmn:outgoing>W07_Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="W07_t4" name="승인 결과 지급에 반영">
      <bpmn:incoming>W07_Flow4</bpmn:incoming>
      <bpmn:outgoing>W07_Flow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W07_t5" name="지급 결과 대사">
      <bpmn:incoming>W07_Flow6</bpmn:incoming>
      <bpmn:outgoing>W07_Flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="W07_t6" name="정산·소명 기록 보관">
      <bpmn:incoming>W07_Flow7</bpmn:incoming>
      <bpmn:outgoing>W07_Flow8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="W07_end_yes" name="정산 기록">
      <bpmn:incoming>W07_Flow8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W07_end_no" name="승인·소명 대기">
      <bpmn:incoming>W07_Flow5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="W07_Flow0" sourceRef="W07_start" targetRef="W07_t1" name=""/>
    <bpmn:sequenceFlow id="W07_Flow1" sourceRef="W07_t1" targetRef="W07_t2" name=""/>
    <bpmn:sequenceFlow id="W07_Flow2" sourceRef="W07_t2" targetRef="W07_t3" name=""/>
    <bpmn:sequenceFlow id="W07_Flow3" sourceRef="W07_t3" targetRef="W07_gate" name=""/>
    <bpmn:sequenceFlow id="W07_Flow4" sourceRef="W07_gate" targetRef="W07_t4" name="예"/>
    <bpmn:sequenceFlow id="W07_Flow5" sourceRef="W07_gate" targetRef="W07_end_no" name="아니오"/>
    <bpmn:sequenceFlow id="W07_Flow6" sourceRef="W07_t4" targetRef="W07_t5" name=""/>
    <bpmn:sequenceFlow id="W07_Flow7" sourceRef="W07_t5" targetRef="W07_t6" name=""/>
    <bpmn:sequenceFlow id="W07_Flow8" sourceRef="W07_t6" targetRef="W07_end_yes" name=""/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="W07_Diagram">
    <bpmndi:BPMNPlane id="W07_Plane" bpmnElement="W07_Collaboration">
      <bpmndi:BPMNShape id="W07_Pool_di" bpmnElement="W07_Pool" isHorizontal="true">
        <dc:Bounds x="24" y="102" width="1752" height="384"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_Lane0_di" bpmnElement="W07_Lane0" isHorizontal="true">
        <dc:Bounds x="54" y="102" width="1722" height="128"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_Lane1_di" bpmnElement="W07_Lane1" isHorizontal="true">
