      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_t2_di" bpmnElement="W07_t2">
        <dc:Bounds x="508.0" y="136.0" width="136" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W07_t3_di" bpmnElement="W07_t3">
        <dc:Bounds x="685.0" y="136.0" width="136" height="60"/>
