      <bpmndi:BPMNEdge id="W03_Flow8_di" bpmnElement="W03_Flow8">
        <di:waypoint x="1529.0" y="422.0"/>
        <di:waypoint x="1622.0" y="422.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
