      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W01_Flow5_di" bpmnElement="W01_Flow5">
        <di:waypoint x="953.0" y="550.0"/>
        <di:waypoint x="1622.0" y="550.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W01_Flow6_di" bpmnElement="W01_Flow6">
        <di:waypoint x="1175.0" y="294.0"/>
        <di:waypoint x="1216.0" y="294.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W01_Flow7_di" bpmnElement="W01_Flow7">
        <di:waypoint x="1352.0" y="294.0"/>
