      <bpmndi:BPMNEdge id="W01_Flow8_di" bpmnElement="W01_Flow8">
        <di:waypoint x="1529.0" y="166.0"/>
        <di:waypoint x="1622.0" y="166.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
